# Database — local npm dev (port 5433, lihat docker-compose.local.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/vibecatalog?schema=public"

# Docker deploy di server — tambahkan juga (lihat .env.production.example):
# APP_DOMAIN=vibecode.agungdigitalid.com
# POSTGRES_USER=agung
# POSTGRES_PASSWORD=...
# POSTGRES_DB=vibecatalog
# RUN_DB_SEED=true

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seed
SEED_ADMIN_EMAIL="agung.bas07@gmail.com"
SEED_ADMIN_NAME="VibeCatalog Admin"
SEED_DEMO_DATA="true"

# Thum.io screenshot API (optional for dev)
THUMIO_API_KEY=""

# App
NEXT_PUBLIC_SITE_NAME="VibeCatalog.id"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
TZ="Asia/Jakarta"
