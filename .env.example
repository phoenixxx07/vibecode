# Database
# Local npm dev with Docker Postgres: use port 5433 (see docker-compose.local.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/vibecatalog?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seed
SEED_ADMIN_EMAIL="agung.bas07@gmail.com"
SEED_ADMIN_NAME="VibeCatalog Admin"
SEED_DEMO_DATA="true"

# Thum.io screenshot API (optional for dev)
THUMIO_API_KEY=""

# App
NEXT_PUBLIC_SITE_NAME="VibeCatalog.id"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
TZ="Asia/Jakarta"
