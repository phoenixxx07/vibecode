# Copy to .env on the server before: docker compose up -d --build

APP_DOMAIN=vibecode.agungdigitalid.com
TRAEFIK_NETWORK=traefik-public
TZ=Asia/Jakarta

# Database (internal Docker network only — no host port)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vibecatalog

# Auth — generate: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_SECRET=

# Google OAuth — add redirect URI:
# https://vibecode.agungdigitalid.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
NEXT_PUBLIC_SITE_NAME=VibeCatalog.id

# Seed (first deploy only, then set RUN_DB_SEED=false)
SEED_ADMIN_EMAIL=agung.bas07@gmail.com
SEED_ADMIN_NAME=VibeCatalog Admin
SEED_DEMO_DATA=false
RUN_DB_SEED=true

# Optional
THUMIO_API_KEY=
