# Salin ke .env di server: cp .env.production.example .env
# Wajib untuk: docker compose up -d --build

APP_DOMAIN=vibecode.agungdigitalid.com
TRAEFIK_NETWORK=traefik-public
TZ=Asia/Jakarta

# Postgres container (internal Docker — bukan localhost)
POSTGRES_USER=agung
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
POSTGRES_DB=vibecatalog

# Jangan set DATABASE_URL di server — dibentuk otomatis di docker-entrypoint.sh
# (password dengan karakter / @ ' dll aman, akan di-URL-encode)

NEXTAUTH_URL=https://vibecode.agungdigitalid.com
NEXTAUTH_SECRET=GANTI_DENGAN_SECRET_YANG_SUDAH_ADA
AUTH_SECRET=GANTI_SAMA_DENGAN_NEXTAUTH_SECRET_ATAU_SECRET_TERPISAH

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_SITE_NAME=Vibe Catalog Indonesia
NEXT_PUBLIC_SITE_URL=https://vibecode.agungdigitalid.com

SEED_ADMIN_EMAIL=agungdigitalindonesia@gmail.com
SEED_ADMIN_NAME=Vibe Catalog
SEED_DEMO_DATA=true
RUN_DB_SEED=true

THUMIO_API_KEY=
